dist/
dist-ssr/
build/
*.tsbuildinfo

# =============================================================================
# Environment / secrets
# Never commit real credentials, DB passwords, or the inverter's network
# config. .env.example stays tracked as the template.
# =============================================================================
.env
.env.*
!.env.example

