// Prisma schema for eam_server.
// Docs: https://pris.ly/d/prisma-schema
//
// Prisma 7: connection config lives in prisma.config.ts, not here — the
// datasource block only declares the provider. The client generator now
// requires an explicit `output` path (no more implicit node_modules
// location) and we pin moduleFormat to match this project's CJS choice.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BatteryType {
  LIFEPO4
  LEAD_ACID
  GEL
  USER_DEFINED
}

/// A registered dashboard account. One account can pair more than one
/// inverter (InverterProfile) over time, though the current onboarding
/// wizard only ever walks a user through configuring one.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inverterProfiles InverterProfile[]
  refreshTokens    RefreshToken[]
  panelTypes       PanelType[]

  @@map("users")
}

/// A solar panel model from its datasheet, in one user's list, reused by
/// all of that user's inverters. Values are at standard test conditions.
model PanelType {
  id        Int    @id @default(autoincrement())
  name      String
  /// Rated power (Pmax).
  maxPowerW Float
  /// Voltage and current at the maximum power point.
  vmpV      Float
  impA      Float
  /// Open-circuit voltage and short-circuit current.
  vocV      Float
  iscA      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("panel_types")
}

/// An issued refresh token. Opaque (a random value, not a JWT) and
/// stored only as a hash, so a leaked database dump alone can't be
/// replayed as a live session. Revoked on rotation (every successful
/// /api/auth/refresh use immediately revokes the token it was called
/// with) or on logout; rows aren't deleted on expiry/revocation, since
/// keeping the history is cheap and harmless.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// The hardware baseline for one paired inverter/battery bank, captured by
/// the setup wizard. Dashboard calculations that need to know the specific
/// installation — load % relative to true rated capacity, SOC-to-kWh
/// conversion, which voltage thresholds count as "low battery" — read from
/// here instead of assuming a fixed spec, since installs vary (a 3.6kW vs
/// 6.2kW inverter, a 24V vs 48V bank, LiFePO4 vs lead-acid discharge
/// curves).
model InverterProfile {
  id   Int    @id @default(autoincrement())
  name String

  /// Wi-Fi Plug Pro logger address, entered in the setup wizard.
  ipAddress String
  port      Int    @default(8899)

  ratedPowerWatts       Int
  batteryNominalVoltage Float
  batteryCapacityAh     Float
  batteryType           BatteryType @default(LIFEPO4)

  /// Optional overrides — when omitted, the frontend/backend fall back to
  /// sane chemistry-based defaults rather than requiring the user to know
  /// exact charge-controller thresholds during onboarding.
  lowBatteryCutoffVoltage Float?
  bulkChargeVoltage       Float?
  floatChargeVoltage      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs              InverterLog[]
  hourlyLogs        InverterLogHourly[]
  settingsSnapshots InverterSettingsSnapshot[]

  /// One profile per physical logger, so two poll loops never share a device.
  @@unique([ipAddress, port])
  @@index([userId])
  @@map("inverter_profiles")
}

/// One polled snapshot of the inverter's live telemetry — a time-series row.
///
/// The decoded reading (register name -> value, see the Register map) is
/// stored as one JSON object rather than one column per metric, since the
/// register list is data-driven and a failed block is simply absent.
///
/// Raw readings are kept forever for long-range analysis; charts over long
/// ranges read InverterLogHourly instead.
model InverterLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())

  /// Aggregated { [parameterName]: value } object for everything that was
  /// successfully read this cycle, e.g. { "LineVoltage": 230.5, "BatterySoc": 100 }.
  payload Json

  /// Nullable rather than required: a row polled before any inverter was
  /// ever paired (legacy .env-only deployments, or the brief window before
  /// the first setup completes) has no profile to attach to yet.
  inverterProfileId Int?
  inverterProfile   InverterProfile? @relation(fields: [inverterProfileId], references: [id], onDelete: SetNull)

  @@index([inverterProfileId, timestamp])
  @@index([timestamp])
  @@map("inverter_logs")
}

/// Hourly averages of InverterLog payloads per profile, maintained by the
/// Telemetry store's roll-up job. Derived data: it can be rebuilt from the
/// raw readings at any time, and raw readings are never deleted.
model InverterLogHourly {
  inverterProfileId Int
  /// Start of the hour (UTC).
  hour              DateTime
  /// Number of raw readings averaged into this hour.
  samples           Int
  /// { [registerName]: average } over the numeric values in that hour.
  averages          Json

  inverterProfile InverterProfile @relation(fields: [inverterProfileId], references: [id], onDelete: Cascade)

  @@id([inverterProfileId, hour])
  @@map("inverter_log_hourly")
}

/// The inverter's settings registers (verified and unverified) as read from
/// the device, kept forever: the history of every change, for working out
/// unidentified registers and for learning how the installation behaves.
///
/// A row is written only when some value differs from the previous snapshot;
/// an identical read just moves `lastSeenAt` on, so each row covers the
/// interval its values held.
model InverterSettingsSnapshot {
  id         Int      @id @default(autoincrement())
  /// First read with these values.
  readAt     DateTime
  /// Latest read that still found these values.
  lastSeenAt DateTime

  /// { [registerName]: value } for every settings register read.
  values  Json
  /// "read" (scheduled or on demand) or "write" (read back right after the
  /// app wrote settings).
  reason  String
  /// For "write": the settings the app wrote, { [registerName]: value }.
  changes Json?

  /// Nullable and kept on profile deletion, like the telemetry history.
  inverterProfileId Int?
  inverterProfile   InverterProfile? @relation(fields: [inverterProfileId], references: [id], onDelete: SetNull)

  @@index([inverterProfileId, readAt])
  @@map("inverter_settings_snapshots")
}
