// Prisma schema for eam_server.
// Docs: https://pris.ly/d/prisma-schema
//
// Prisma 7: connection config lives in prisma.config.ts, not here — the
// datasource block only declares the provider. The client generator now
// requires an explicit `output` path (no more implicit node_modules
// location) and we pin moduleFormat to match this project's CJS choice.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BatteryType {
  LIFEPO4
  LEAD_ACID
  GEL
  USER_DEFINED
}

/// A registered dashboard account. One account can pair more than one
/// inverter (InverterProfile) over time, though the current onboarding
/// wizard only ever walks a user through configuring one.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens        RefreshToken[]
  memberships          Membership[]
  telegramLink         TelegramLink?
  telegramCodes        TelegramLinkCode[]
  notificationSettings NotificationSettings?
  /// The app and Telegram language the user chose ("en" or "uk"); null: the
  /// browser's.
  language             String?
  /// May look at the server page; chosen by the server's owner.
  serverViewer         Boolean               @default(false)
  serverOwner          ServerOwner?

  @@map("users")
}

/// The server's owner: one user for the whole installation, apart from
/// households. Runs the server page and chooses who else may look at it.
/// One row only (id 1, checked in the database).
model ServerOwner {
  id     Int  @id @default(1)
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("server_owner")
}

/// The server agent: one, reporting the host it runs on. One row only
/// (id 1, checked in the database).
model ServerAgent {
  id         Int       @id @default(1)
  tokenHash  String    @unique
  lastSeenAt DateTime?

  @@map("server_agent")
}

/// One reading of the host by the agent (see server-agent/sample.ts).
model ServerSample {
  id   Int      @id @default(autoincrement())
  at   DateTime @unique
  data Json

  @@map("server_samples")
}

/// Who runs the host's fan: the firmware, the agent by the rules, or the
/// agent at a fixed speed.
enum ServerFanMode {
  FIRMWARE
  AUTO
  MANUAL
}

/// The owner's fan settings, handed to the agent with each report. One row
/// only (id 1, checked in the database); none means the defaults.
model ServerFanSettings {
  id            Int           @id @default(1)
  mode          ServerFanMode @default(FIRMWARE)
  /// AUTO: never slower than this (0-100 %).
  minPercent    Int           @default(0)
  /// MANUAL: the speed (0-100 %).
  manualPercent Int           @default(100)
  /// AUTO: [{ aboveC, percent }], in order of temperature.
  rules         Json
  updatedAt     DateTime      @updatedAt

  @@map("server_fan_settings")
}

/// The owner's limits for the server notices. One row only (id 1, checked
/// in the database); none means the defaults.
model ServerAlertSettings {
  id                 Int      @id @default(1)
  /// Overheating at or above this, on any sensor.
  heatC              Int      @default(90)
  /// Storage low below this share free, on any filesystem.
  storageFreePercent Int      @default(10)
  /// Memory short at or above this share used.
  memoryUsedPercent  Int      @default(90)
  updatedAt          DateTime @updatedAt

  @@map("server_alert_settings")
}

/// A server notice as sent, for the Server page.
model ServerAlertEvent {
  id   Int      @id @default(autoincrement())
  /// server-heat | server-storage | server-memory | server-agent | server-updates
  kind   String
  /// In English; shown as is when there is no key (notices kept before keys).
  text   String
  /// The message key under "alerts" in src/i18n/locales, worded per reader.
  key    String?
  /// The message's values (see src/alerts/alert-message.ts).
  params Json?
  at     DateTime @default(now())

  @@index([at])
  @@map("server_alert_events")
}

/// What a member may do in a household: ADMIN everything, READER only read.
enum HouseholdRole {
  ADMIN
  READER
}

/// A home's installation: its inverters and panel types, shared by its
/// members.
model Household {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  inverterProfiles InverterProfile[]
  panelTypes       PanelType[]
  invites          HouseholdInvite[]

  @@map("households")
}

/// A single-use invite to a household, stored as a hash of its code.
model HouseholdInvite {
  id          Int           @id @default(autoincrement())
  role        HouseholdRole
  codeHash    String        @unique
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    Int?
  createdById Int?
  createdAt   DateTime      @default(now())

  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invites")
}

/// A user's role in a household.
model Membership {
  id        Int           @id @default(autoincrement())
  role      HouseholdRole
  createdAt DateTime      @default(now())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
  @@map("household_memberships")
}

/// A solar panel model from its datasheet, in one user's list, reused by
/// all of that user's inverters. Values are at standard test conditions.
model PanelType {
  id        Int    @id @default(autoincrement())
  name      String
  /// Rated power (Pmax).
  maxPowerW Float
  /// Voltage and current at the maximum power point.
  vmpV      Float
  impA      Float
  /// Open-circuit voltage and short-circuit current.
  vocV      Float
  iscA      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  inverterProfiles InverterProfile[]

  @@unique([householdId, name])
  @@map("panel_types")
}

/// An issued refresh token. Opaque (a random value, not a JWT) and
/// stored only as a hash, so a leaked database dump alone can't be
/// replayed as a live session. Revoked on rotation (every successful
/// /api/auth/refresh use immediately revokes the token it was called
/// with) or on logout; rows aren't deleted on expiry/revocation, since
/// keeping the history is cheap and harmless.
model RefreshToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  /// One browser's sign-in: kept by every rotation of its refresh token.
  sessionId  String
  /// The browser's User-Agent when it signed in.
  userAgent  String?
  /// When this token was issued, i.e. the session's last refresh.
  lastUsedAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sessionId])
  @@map("refresh_tokens")
}

/// The hardware baseline for one paired inverter/battery bank, captured by
/// the setup wizard. Dashboard calculations that need to know the specific
/// installation — load % relative to true rated capacity, SOC-to-kWh
/// conversion, which voltage thresholds count as "low battery" — read from
/// here instead of assuming a fixed spec, since installs vary (a 3.6kW vs
/// 6.2kW inverter, a 24V vs 48V bank, LiFePO4 vs lead-acid discharge
/// curves).
model InverterProfile {
  id   Int    @id @default(autoincrement())
  name String

  /// Wi-Fi Plug Pro logger address, entered in the setup wizard.
  ipAddress String
  port      Int    @default(8899)

  ratedPowerWatts       Int
  batteryNominalVoltage Float
  batteryCapacityAh     Float
  batteryType           BatteryType @default(LIFEPO4)

  /// Optional overrides — when omitted, the frontend/backend fall back to
  /// sane chemistry-based defaults rather than requiring the user to know
  /// exact charge-controller thresholds during onboarding.
  lowBatteryCutoffVoltage Float?
  bulkChargeVoltage       Float?
  floatChargeVoltage      Float?

  /// The solar array on the PV input: one panel type, `pvPanelsInSeries`
  /// per string, `pvStrings` strings in parallel. All null until set up.
  pvPanelTypeId    Int?
  pvPanelType      PanelType? @relation(fields: [pvPanelTypeId], references: [id], onDelete: Restrict)
  pvPanelsInSeries Int?
  pvStrings        Int?

  /// The inverter's PV input limits from its datasheet, entered by the
  /// user; the array is checked against whichever are set.
  pvMaxVocV     Float?
  pvMpptMinV    Float?
  pvMpptMaxV    Float?
  pvMaxPowerW   Float?
  pvMaxCurrentA Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  logs              InverterLog[]
  hourlyLogs        InverterLogHourly[]
  settingsSnapshots InverterSettingsSnapshot[]
  bmsDevices        BmsDevice[]
  outageSource      OutageSource?
  alertEvents       AlertEvent[]

  /// One profile per physical logger, so two poll loops never share a device.
  @@unique([ipAddress, port])
  @@index([householdId])
  @@map("inverter_profiles")
}

/// One polled snapshot of the inverter's live telemetry — a time-series row.
///
/// The decoded reading (register name -> value, see the Register map) is
/// stored as one JSON object rather than one column per metric, since the
/// register list is data-driven and a failed block is simply absent.
///
/// Raw readings are kept forever for long-range analysis; charts over long
/// ranges read InverterLogHourly instead.
model InverterLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())

  /// Aggregated { [parameterName]: value } object for everything that was
  /// successfully read this cycle, e.g. { "LineVoltage": 230.5, "BatterySoc": 100 }.
  payload Json

  /// Nullable rather than required: a row polled before any inverter was
  /// ever paired (legacy .env-only deployments, or the brief window before
  /// the first setup completes) has no profile to attach to yet.
  inverterProfileId Int?
  inverterProfile   InverterProfile? @relation(fields: [inverterProfileId], references: [id], onDelete: SetNull)

  @@index([inverterProfileId, timestamp])
  @@index([timestamp])
  @@map("inverter_logs")
}

/// Hourly averages of InverterLog payloads per profile, maintained by the
/// Telemetry store's roll-up job. Derived data: it can be rebuilt from the
/// raw readings at any time, and raw readings are never deleted.
model InverterLogHourly {
  inverterProfileId Int
  /// Start of the hour (UTC).
  hour              DateTime
  /// Number of raw readings averaged into this hour.
  samples           Int
  /// { [registerName]: average } over the numeric values in that hour.
  averages          Json

  inverterProfile InverterProfile @relation(fields: [inverterProfileId], references: [id], onDelete: Cascade)

  @@id([inverterProfileId, hour])
  @@map("inverter_log_hourly")
}

/// The inverter's settings registers (verified and unverified) as read from
/// the device, kept forever: the history of every change, for working out
/// unidentified registers and for learning how the installation behaves.
///
/// A row is written only when some value differs from the previous snapshot;
/// an identical read just moves `lastSeenAt` on, so each row covers the
/// interval its values held.
model InverterSettingsSnapshot {
  id         Int      @id @default(autoincrement())
  /// First read with these values.
  readAt     DateTime
  /// Latest read that still found these values.
  lastSeenAt DateTime

  /// { [registerName]: value } for every settings register read.
  values  Json
  /// "read" (scheduled or on demand) or "write" (read back right after the
  /// app wrote settings).
  reason  String
  /// For "write": the settings the app wrote, { [registerName]: value }.
  changes Json?

  /// Nullable and kept on profile deletion, like the telemetry history.
  inverterProfileId Int?
  inverterProfile   InverterProfile? @relation(fields: [inverterProfileId], references: [id], onDelete: SetNull)

  @@index([inverterProfileId, readAt])
  @@map("inverter_settings_snapshots")
}

/// A battery management system reporting for one inverter's battery. Its
/// readings arrive from a producer outside the server (a Mac Bluetooth
/// reader now, an ESP32 later) that authenticates with the device's ingest
/// token, which is shown once and stored only as a hash.
model BmsDevice {
  id               Int       @id @default(autoincrement())
  name             String
  /// Which producer sends its readings: "mac-ble" or "esp32".
  sourceType       String
  /// The reader's Bluetooth peripheral id, for reference.
  bluetoothId      String?
  tokenHash        String    @unique
  /// When the last reading arrived (not only the stored ones).
  lastSeenAt       DateTime?
  /// Show this BMS's live values for the battery in the energy flow instead
  /// of the inverter's estimate. Off until the owner has confirmed the
  /// current's sign on the real unit (docs/bms-first-run.md, step 7).
  useForEnergyFlow Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inverterProfileId Int
  inverterProfile   InverterProfile @relation(fields: [inverterProfileId], references: [id], onDelete: Cascade)

  logs       BmsLog[]
  hourlyLogs BmsLogHourly[]

  @@index([inverterProfileId])
  @@map("bms_devices")
}

/// One stored BMS reading: the normalized reading as JSON, at most one per
/// storage interval per device. Kept forever, like InverterLog.
model BmsLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime
  payload   Json

  bmsDeviceId Int
  bmsDevice   BmsDevice @relation(fields: [bmsDeviceId], references: [id], onDelete: Cascade)

  @@unique([bmsDeviceId, timestamp])
  @@map("bms_logs")
}

/// Hourly averages of the numeric fields of BmsLog, kept by the roll-up
/// job, for long history ranges (like InverterLogHourly).
model BmsLogHourly {
  bmsDeviceId Int
  /// Start of the hour (UTC).
  hour        DateTime
  samples     Int
  averages    Json

  bmsDevice BmsDevice @relation(fields: [bmsDeviceId], references: [id], onDelete: Cascade)

  @@id([bmsDeviceId, hour])
  @@map("bms_log_hourly")
}

/// A Telegram chat linked to a user: the bot answers and alerts there with
/// the user's read rights. One chat per user.
model TelegramLink {
  id        Int      @id @default(autoincrement())
  /// Telegram chat id, as text (it can exceed 32 bits).
  chatId    String   @unique
  createdAt DateTime @default(now())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

/// A one-time code a user sends to the bot (/start <code>) to link a chat.
model TelegramLinkCode {
  id        Int      @id @default(autoincrement())
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_codes")
}

/// An alert as it happened: a fault, warning, grid change, low battery or a
/// silent logger or BMS reader. Recorded when it is detected (and sent to
/// Telegram, when linked), so the Alerts page can show the history.
model AlertEvent {
  id     Int      @id @default(autoincrement())
  /// fault | warning | grid | battery | connection
  kind   String
  /// In English; shown as is when there is no key (alerts kept before keys).
  text   String
  /// The message key under "alerts" in src/i18n/locales, worded per reader.
  key    String?
  /// The message's values (see src/alerts/alert-message.ts).
  params Json?
  /// The BMS device's name, for BMS alerts.
  source String?
  at     DateTime @default(now())

  inverterProfileId Int
  inverterProfile   InverterProfile @relation(fields: [inverterProfileId], references: [id], onDelete: Cascade)

  @@index([inverterProfileId, at])
  @@map("alert_events")
}

/// A user's notification choices: for each kind of alert and the evening
/// summary, whether it shows in the app and goes to Telegram; and quiet
/// hours. No row means the defaults (see notifications/notification-settings.ts).
model NotificationSettings {
  id        Int      @id @default(autoincrement())
  settings  Json
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum OutageHouseState {
  /// The reader has not looked the house up yet (new or changed address).
  PENDING
  FOUND
  /// The house is not on the site's list for the street.
  NOT_FOUND
}

/// Where an inverter's outage schedule comes from: a DTEK site and the
/// address on it, at most one per inverter. The outage schedule reader asks
/// for it with its token and checks it.
model OutageSource {
  id                 Int              @id @default(autoincrement())
  /// DTEK site key; "dnem" (DTEK Dnipro) is the only one so far.
  site               String           @default("dnem")
  /// City, street and house in the site's own spelling.
  city               String
  street             String
  house              String
  enabled            Boolean          @default(true)
  houseState         OutageHouseState @default(PENDING)
  /// The house's outage groups as the reader found them (e.g. GPV5.2);
  /// empty while pending, not found, or when the site lists none.
  groups             String[]         @default([])
  tokenHash          String           @unique
  /// When the reader last asked for this source.
  lastSeenAt         DateTime?
  /// When someone in the app asked for a check now; done once a later check
  /// is stored.
  refreshRequestedAt DateTime?

  checks         OutageCheck[]
  weeklyPatterns OutageWeeklyPattern[]
  confirmedDays  OutageConfirmedDay[]
  events         OutageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inverterProfileId Int             @unique
  inverterProfile   InverterProfile @relation(fields: [inverterProfileId], references: [id], onDelete: Cascade)

  @@map("outage_sources")
}

/// A DTEK site's city -> streets list, uploaded by the reader for the address
/// pickers and replaced when it changes.
model OutageSiteStreets {
  site      String   @id
  /// { city: [street, ...] }
  streets   Json
  /// sha256 of the uploaded list, to tell an unchanged one.
  hash      String
  updatedAt DateTime @updatedAt

  @@map("outage_site_streets")
}

/// How one check of the site went: OK, or why it failed (see the reader's
/// SiteError kinds).
enum OutageCheckOutcome {
  OK
  CHALLENGE
  REJECTED
  SHAPE
  SERVER
  NETWORK
}

/// One check of the site by the reader, whatever its outcome. Tells "no
/// outage was scheduled" (an OK check saw none) from "not known" (checks
/// failed).
model OutageCheck {
  id          Int                @id @default(autoincrement())
  /// When the reader made the check; with the source, identifies it.
  checkedAt   DateTime
  outcome     OutageCheckOutcome
  /// Whether the check went through the browser.
  usedBrowser Boolean            @default(false)
  error       String?

  sourceId Int
  source   OutageSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, checkedAt])
  @@map("outage_checks")
}

/// A version of one group's weekly pattern; a new row only when it changes.
model OutageWeeklyPattern {
  id     Int      @id @default(autoincrement())
  group  String
  /// { "1" (Monday) .. "7": [24 slot statuses] }
  days   Json
  /// sha256 of `days`, to tell an unchanged pattern.
  hash   String
  /// When a check first saw this version.
  seenAt DateTime

  sourceId Int
  source   OutageSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, group, seenAt])
  @@map("outage_weekly_patterns")
}

/// One group's confirmed schedule for one Kyiv day: the latest version seen,
/// kept after the day has passed.
model OutageConfirmedDay {
  id          Int      @id @default(autoincrement())
  day         DateTime @db.Date
  group       String
  /// [24 slot statuses], 00:00-01:00 first.
  slots       Json
  /// The site's "updated" stamp of this version, Kyiv time.
  siteUpdated String
  /// When a check first saw the day, and when the slots last changed.
  firstSeenAt DateTime
  changedAt   DateTime

  sourceId Int
  source   OutageSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, group, day])
  @@map("outage_confirmed_days")
}

enum OutageEventKind {
  /// A window of the confirmed schedule of the house's group(s).
  SCHEDULE
  /// A repair outage the site lists for the house itself.
  REPAIR
}

enum OutageEventStatus {
  OFF
  POSSIBLE
  UNKNOWN
}

/// One outage as the checks saw it over time: when it was announced, how its
/// times were revised, and whether it was withdrawn (gone from the site before
/// its end: finished early or cancelled). Events that have ended are kept as
/// last seen.
model OutageEvent {
  id             Int               @id @default(autoincrement())
  kind           OutageEventKind
  status         OutageEventStatus
  /// The site's description of a repair, e.g. "Аварійні ремонтні роботи".
  description    String?
  /// The times as last seen.
  start          DateTime
  end            DateTime
  /// The times when first seen.
  announcedStart DateTime
  announcedEnd   DateTime
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  /// When a check last changed its times or description.
  revisedAt      DateTime?
  withdrawnAt    DateTime?

  sourceId Int
  source   OutageSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, start])
  @@map("outage_events")
}
