# Copy this file to .env and adjust values before running `docker compose up`.
# docker compose automatically loads a .env file from the project root.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=eam_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eam_db
DB_PORT=5432

# ---------------------------------------------------------------------------
# Build target: "development" (hot-reload, source mounted as a volume) or
# "production" (compiled/minified image, no live-reload).
# ---------------------------------------------------------------------------
BUILD_TARGET=development
NODE_ENV=development

# ---------------------------------------------------------------------------
# NestJS backend (eam_server)
# ---------------------------------------------------------------------------
SERVER_PORT=3000

# ---------------------------------------------------------------------------
# React frontend (eam_front)
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
# Any long random string, e.g. `openssl rand -base64 48`. Required — there
# is deliberately no built-in default, since a hardcoded fallback would let
# anyone who has read the source forge valid login tokens.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# EASUN ISOLAR SMX-II inverter (Modbus TCP over Wi-Fi)
# ---------------------------------------------------------------------------
# There is deliberately no INVERTER_IP here. Every inverter is paired
# per-account through the in-app setup wizard (stored in InverterProfile)
# — polling only ever runs against a real, owned profile, never against a
# bare address from .env with no user attached. Pairing a mock/emulated
# device (scripts/mock-inverter.js) for local development goes through
# the same wizard, not this file.
#
# INVERTER_PORT is just the default port used when one isn't specified
# (e.g. the "Verify Logger" pairing test) — 8899 is the Wi-Fi Plug Pro
# adapter's actual TCP port (not the standard Modbus TCP port 502, which
# this device doesn't use).
INVERTER_PORT=8899
# Timeout (ms) applied to the UDP handshake, the TCP connect, and each
# per-register request/response — raise this if you see frequent timeouts
# on a slow or congested network.
INVERTER_TIMEOUT_MS=3000
POLLING_INTERVAL_MS=5000
