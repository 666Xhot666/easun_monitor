# Copy this file to .env and adjust values before running `docker compose up`.
# docker compose automatically loads a .env file from the project root.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=eam_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eam_db
DB_PORT=5432

# ---------------------------------------------------------------------------
# Build target: "development" (hot-reload, source mounted as a volume) or
# "production" (compiled/minified image, no live-reload).
# ---------------------------------------------------------------------------
BUILD_TARGET=development
NODE_ENV=development

# ---------------------------------------------------------------------------
# NestJS backend (eam_server)
# ---------------------------------------------------------------------------
SERVER_PORT=3000

# ---------------------------------------------------------------------------
# React frontend (eam_front)
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
# Any long random string, e.g. `openssl rand -base64 48`. Required — there
# is deliberately no built-in default, since a hardcoded fallback would let
# anyone who has read the source forge valid login tokens.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# The first account can always register. After that, sign-up is closed
# unless this is true (e.g. while adding a family member's account).
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------
# Telegram bot (optional). Create a bot with @BotFather and put its token
# here; without a token the bot is off. Users link their chat from the
# Household page.
TELEGRAM_BOT_TOKEN=
# Battery level (%) that triggers a low-battery alert.
TELEGRAM_LOW_SOC=20
# When the evening summary goes out (HH:MM), and the time zone that sets it
# and what "today" means for /energy (IANA name, e.g. Europe/Kyiv).
TELEGRAM_SUMMARY_TIME=21:00
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# EASUN ISOLAR SMG-II inverter (Wi-Fi Plug Pro logger)
# ---------------------------------------------------------------------------
# There is no inverter address here: every inverter (real or the simulator
# in scripts/mock-inverter.ts) is paired per account in the setup wizard,
# with its logger's LAN address and port (8899 on the Wi-Fi Plug Pro).
#
# Timeout (ms) for the UDP handshake, the TCP connect, and each reply.
# Raise it if the logger's Wi-Fi is slow or congested.
INVERTER_TIMEOUT_MS=3000
# The server only connects to loggers on private networks (LAN, loopback,
# link-local), so an account can't use it to probe arbitrary hosts. Set to
# true only if your logger is genuinely reached through a public address.
ALLOW_PUBLIC_LOGGER_HOSTS=false
# How often telemetry is read from each inverter.
POLLING_INTERVAL_MS=5000
# Settings change only when edited, so they're re-read on a slow cadence.
SETTINGS_REFRESH_MS=300000
#
# BMS readings: the server stores at most one per this interval per device
# (the BMS streams about one a second; the newest is always kept for the
# live view).
BMS_STORE_INTERVAL_MS=30000
#
# --- BMS reader (npm run bms-reader in eam_server, outside Docker) ---
# Reads a JK BMS over Bluetooth and posts its readings to BMS_INGEST_URL.
# BMS_NAME: advertised-name prefix; BMS_ID: the id from
# `npm run bms-reader -- --scan` (picks one BMS when several are near): a
# per-machine UUID on macOS, the Bluetooth address on Linux.
BMS_NAME=JK-
BMS_ID=
# JK02_32S (hardware/software 11.x and later), JK02_24S (10.x) or JK04.
BMS_PROTOCOL=JK02_32S
# The server's ingest endpoint and the token shown once when the BMS is
# added to the inverter in the app. Leave empty to read and capture only.
BMS_INGEST_URL=
BMS_INGEST_TOKEN=
BMS_SEND_INTERVAL_MS=5000
#
# --- Outage schedule reader (npm run outage-reader in eam_server, outside Docker) ---
# Checks the grid operator's site for the address set in the app (inverter
# Settings > Outage schedule) and reports to the server. The token is shown
# once when the address is first saved there.
OUTAGE_SERVER_URL=
OUTAGE_READER_TOKEN=
# The grid operator's site with the outage schedule, e.g. https://www.example.com
OUTAGE_SITE_URL=
# Check every OUTAGE_INTERVAL_MINUTES, and every OUTAGE_EVENING_INTERVAL_MINUTES
# during OUTAGE_EVENING (Kyiv time), when the next day's schedule is usually
# published. After the site turns even the browser away, wait OUTAGE_BLOCKED_HOURS.
OUTAGE_INTERVAL_MINUTES=120
OUTAGE_EVENING_INTERVAL_MINUTES=30
OUTAGE_EVENING=18:00-23:00
OUTAGE_BLOCKED_HOURS=6
# One check a week goes through the headless browser on purpose.
OUTAGE_BROWSER_EVERY_DAYS=7
OUTAGE_STATE_FILE=.outage-reader-state.json
#
# --- Server agent (npm run server-agent in eam_server, outside Docker) ---
# Reports the host (CPU, memory, disks, network, temperatures, fans, services,
# containers) to the Server page. The owner makes the token under
# Settings > Server access.
SERVER_AGENT_URL=
SERVER_AGENT_TOKEN=
SERVER_AGENT_INTERVAL_SECONDS=60
# systemd units shown on the Server page, comma-separated; "none" for none.
SERVER_AGENT_SERVICES=easun-serial-logger,easun-bms-reader,easun-outage-reader,easun-server-agent
# How often to look for package updates (apt list --upgradable; nothing is
# refreshed or installed), in hours; 0: do not look.
SERVER_AGENT_UPDATES_HOURS=6
# The fan the agent runs as set on the Server page: its hwmon name
# (cat /sys/class/hwmon/*/name; the one with a pwm1). Empty: the agent only
# reports. SERVER_AGENT_FAN_STEPS: how many fixed speeds it has, off included,
# for a fan that only has a few (empty: any speed).
SERVER_AGENT_FAN=
SERVER_AGENT_FAN_STEPS=
#
# --- Development only (ignored when NODE_ENV=production) ---
# Sign in automatically as this account when the app loads (created if missing).
DEV_AUTO_LOGIN=false
DEV_AUTO_LOGIN_EMAIL=
# Serial capture panel at /dev/serial, for two USB-serial taps on the logger's
# RX pad (responses) and TX pad (requests). Needs the server running natively
# (Docker on macOS can't reach USB). Captures are saved in DEV_CAPTURE_DIR.
DEV_SERIAL_SNIFF=false
SERIAL_RX_PORT=
SERIAL_TX_PORT=
SERIAL_RX_BAUD=9600
SERIAL_TX_BAUD=9600
DEV_CAPTURE_DIR=.dev-captures
